{
  "name": "glpweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --disable-nested-config",
    "types": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "node scripts/emulators.mjs exec --only auth,firestore,database -- npm run test:emulated",
    "test:emulated": "vitest run --config vitest.rules.config.ts && vitest run --config vitest.emu.config.ts",
    "test:mutation": "node scripts/emulators.mjs exec --only firestore,database -- node scripts/mutate-rules.mjs",
    "seed": "node tests/seed/seed.ts",
    "guard": "node scripts/check-public.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "check": "npm run guard && npm run format:check && npm run lint && npm run types && npm run test && npm run test:rules",
    "emulators": "node scripts/emulators.mjs start",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/gabarito": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "firebase": "^13.0.0",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "firebase-admin": "^14.5.0",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "shadcn": "^4.21.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
